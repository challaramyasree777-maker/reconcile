# Database & Auth
# For local development with SQLite:
#   DATABASE_URL=sqlite:///./reconcile.db
# For production Postgres (replace with real values):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/reconcile
DATABASE_URL=sqlite:///./reconcile.db
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@example.com
# Leave ADMIN_PASSWORD blank to have a random password auto-generated and printed
# to the server log on first startup. Set a strong value here to pin it.
ADMIN_PASSWORD=
TEST_DATABASE_URL=

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# External APIs & Sandbox Credentials
RECONCILE_API_URL=http://localhost:8000
GROQ_API_KEY=
ANTHROPIC_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=
QB_ENVIRONMENT=sandbox
